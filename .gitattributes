# Git LFS — large binaries kept out of regular git history.
# Vercel smudges these on clone before `npm install` / `next build` runs.

# ZK proving artifacts (served from public/, fetched on-demand by the privacy module)
public/artifacts/*.zkey filter=lfs diff=lfs merge=lfs -text
public/artifacts/*.wasm filter=lfs diff=lfs merge=lfs -text

# Vendored privacy-pools SDK build output (file: dependency — see package.json)
vendor/privacy-pools-core-sdk/dist/**/*.js  filter=lfs diff=lfs merge=lfs -text
vendor/privacy-pools-core-sdk/dist/**/*.mjs filter=lfs diff=lfs merge=lfs -text
vendor/privacy-pools-core-sdk/dist/**/*.map filter=lfs diff=lfs merge=lfs -text
